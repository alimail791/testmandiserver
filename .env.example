# Copy this file to ".env" and fill in your own values before running the server.

PORT=4000

# Where your frontend runs. One URL, or a comma-separated list (e.g. your local
# dev server AND your deployed frontend) — no trailing slashes.
CORS_ORIGIN=http://localhost:5173

# Your MongoDB Atlas connection string. Get a free M0 cluster at
# https://cloud.mongodb.com — create a cluster, add a database user
# (Database Access), allow your IP or 0.0.0.0/0 for access (Network Access —
# use 0.0.0.0/0 if your host's IP changes/isn't known, e.g. most PaaS hosts),
# then "Connect" -> "Drivers" to get this string. It looks like:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=testmandi

# Real email for verification/password-reset links. Leave everything below
# blank and emails print to the server console instead (fine for local dev).
#
# OPTION A — Resend (recommended if deployed on Railway or similar hosts):
# many cloud platforms block outbound SMTP ports to prevent spam abuse, which
# makes Option B below time out even with correct credentials, even though it
# works fine locally. Resend sends over a normal HTTPS API call instead, which
# is never blocked. Free tier is generous. Sign up at https://resend.com,
# grab an API key, and set just these two:
RESEND_API_KEY=
RESEND_FROM=TestMandi <onboarding@resend.dev>

# OPTION B — SMTP (works well locally, and on hosts that allow outbound SMTP
# like a plain VPS). Ignored if RESEND_API_KEY above is set.
#
# Easiest option since you own testmandi.in: create a real mailbox in
# Hostinger's hPanel (Emails section, e.g. no-reply@testmandi.in), then use:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=no-reply@testmandi.in
#   SMTP_PASS=the mailbox's actual password (not this placeholder text!)
#   SMTP_FROM=TestMandi <no-reply@testmandi.in>
#
# Gmail also works — enable 2-Step Verification on the Google account, then
# generate an "app password" at https://myaccount.google.com/apppasswords:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=the 16-character app password (not your normal Gmail password)
#   SMTP_FROM=TestMandi <youraddress@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# The single real URL of your frontend, used to build links inside emails.
# Separate from CORS_ORIGIN because that can be a list — this must be one
# URL only. Example: https://testmandi.in
PUBLIC_APP_URL=http://localhost:5173

# Set to "true" to seed 6 sample tests and a demo bundle on first run — handy
# for trying the app out locally. Leave unset/false for a real deployment so
# your marketplace starts empty.
SEED_DEMO_DATA=false

# Any long random string — used to sign login tokens. Change this to something unique.
JWT_SECRET=change_this_to_a_long_random_string

# The first admin account, created automatically the first time the server starts.
# Change the password after your first login (there's no "change password" endpoint
# yet — for now, edit the admin's passwordHash directly in MongoDB Atlas's
# collection browser, or delete that one user document and restart to reseed).
ADMIN_EMAIL=admin@testmandi.in
ADMIN_PASSWORD=admin123

# Get test-mode keys free at https://dashboard.razorpay.com (Settings -> API Keys).
# Test mode lets you simulate payments with dummy card/UPI details — no real money moves.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Real seller payouts via RazorpayX (separate product from the payment gateway
# above — requires its own RazorpayX current account and business KYC with
# Razorpay). Find your account number in the RazorpayX Dashboard under
# My Account & Settings -> Banking. Leave blank to keep the old simulated
# payout flow (money is never actually transferred, only tracked).
RAZORPAYX_ACCOUNT_NUMBER=

# Optional: only needed if you configure a webhook in your Razorpay dashboard
# (Account & Settings -> Webhooks) pointing at
# https://your-backend-domain/api/webhooks/razorpayx-payout with the "payout"
# events enabled, so payout status updates (e.g. a queued payout finally
# clearing) reach this server asynchronously. Use the same secret you set
# there.
RAZORPAYX_WEBHOOK_SECRET=

# Get this from https://console.anthropic.com (API Keys). Needed only for the
# support chatbot — everything else works without it.
ANTHROPIC_API_KEY=sk-ant-your-key-here
